# ═══════════════════════════════════════════════════════════════
# CLUB PENGUIN LOCAL ENVIRONMENT — Variables de Configuracion (Plantilla)
# Copia este archivo como .env antes de iniciar Docker Compose
# ═══════════════════════════════════════════════════════════════

# Rutas base
CPPS_ROOT=./data
CPPS_MEDIA_ROOT=../media

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cpps_admin
POSTGRES_PASSWORD=cambiar_password_seguro
POSTGRES_DB_HOUDINI=houdini
POSTGRES_DB_TIMELINE=timeline

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Houdini (Emulador AS2/AS3)
HOUDINI_LOGIN_PORT=6112
HOUDINI_WORLD_PORT=9875
HOUDINI_GAME_ADDRESS=localhost
HOUDINI_WEB_PORT=3000

# Timeline
TIMELINE_LOGIN_PORT=6113
TIMELINE_WORLD_PORT=9876
TIMELINE_GAME_ADDRESS=localhost

# OpenCPIsland (3D)
OPENCPI_SERVER_PORT=9933
OPENCPI_MODE=offline

# Nginx
NGINX_HTTP_PORT=8080
MEDIA_DOMAIN=media.localhost
PLAY_DOMAIN=play.localhost

# Docker Compose
COMPOSE_PROJECT_NAME=cpps-local
